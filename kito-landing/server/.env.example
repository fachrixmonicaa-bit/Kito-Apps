# Contoh konfigurasi koneksi database MySQL di cPanel
# Format URL: mysql://USER:PASSWORD@HOST:PORT/DATABASE
# - USER: Username database Anda di cPanel (misal: kitouser)
# - PASSWORD: Password dari user tersebut
# - HOST: Biasanya "localhost" atau "127.0.0.1" jika Node.js dan MySQL berada di server yang sama
# - PORT: Biasanya 3306
# - DATABASE: Nama database yang Anda buat (misal: kitodb)

DATABASE_URL="mysql://username_anda:password_anda@localhost:3306/nama_database_anda"

# Port untuk menjalankan server Node.js
PORT=5000
